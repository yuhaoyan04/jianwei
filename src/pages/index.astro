---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import BrandMark from '../components/BrandMark.astro';
import { SITE, SECTIONS } from '../lib/sections';
import {
  loadAll,
  sortByPublished,
  seriesForSection,
  articlesForSeries,
  articleHref,
  seriesHref,
} from '../lib/content';

const { articlesAll, seriesMap } = await loadAll();
const recent = sortByPublished(articlesAll).slice(0, 6);
const recentItems = recent.map((a) => {
  const s = seriesMap.get(a.data.series);
  const sectionId = s ? s.data.section : '';
  return { entry: a, href: articleHref(sectionId, a.data.series, a.id) };
});

const moduleIndex = await Promise.all(
  SECTIONS.map(async (sec) => {
    const mods = await seriesForSection(sec.id);
    const modsData = await Promise.all(
      mods.map(async (m) => {
        const arts = await articlesForSeries(m.id);
        return { module: m, count: arts.length, latest: arts[0] };
      })
    );
    return { section: sec, modules: modsData };
  })
);
---
<BaseLayout title={`${SITE.name} / ${SITE.nameEn}`} description={`${SITE.name} / ${SITE.nameEn} — ${SITE.slogan}`}>
  <section class="hero">
    <BrandMark size={64} class="hero-mark" />
    <h1 class="wordmark">見<span class="em">微</span></h1>
    <div class="hero-name">Jianwei</div>
    <p class="hero-slogan">{SITE.slogan}</p>
    <p class="hero-sub">记一份私人笔记：把复杂问题拆到最小，再重新拼回世界的样子。</p>
    <div class="social">
      <a href="https://github.com/yuhaoyan04/jianwei" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </section>

  <section>
    <div class="block-head">
      <h2>最近文章</h2>
      <a href="/posts">全部 →</a>
    </div>
    {recentItems.length > 0 ? (
      <PostList items={recentItems} />
    ) : (
      <div class="empty">还没有文章。</div>
    )}
  </section>

  <section>
    <div class="block-head">
      <h2>专题导览 / Modules</h2>
      <span class="tag">{moduleIndex.reduce((n, x) => n + x.modules.length, 0)} modules</span>
    </div>
    {moduleIndex.map(({ section, modules }) => (
      <div style="margin-top: 20px;">
        <div class="year-head">
          <h3><span class={`sedot ${section.id}`}></span>{section.title}</h3>
          <a href={`/${section.id}`} class="count">查看 →</a>
        </div>
        {modules.length > 0 ? (
          <ul class="module-list">
            {modules.map(({ module, count, latest }) => (
              <li>
                <div class="row">
                  <a class="mt" href={seriesHref(section.id, module.id)}>{module.data.title}</a>
                  <span class="mc">{count} 篇{latest ? ` · ${new Date(latest.data.published).getFullYear()}` : ''}</span>
                </div>
                <div class="md">{module.data.summary}</div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty">还没有专题。</div>
        )}
      </div>
    ))}
  </section>
</BaseLayout>
