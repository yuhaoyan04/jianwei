---
import { SECTIONS } from '../lib/sections';
import ThemeSettings from './ThemeSettings.astro';
const path = Astro.url.pathname.replace(/\/+$/, '');
const current = SECTIONS.find((s) => path === `/${s.id}` || path.startsWith(`/${s.id}/`))?.id;
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.4" />
        <circle cx="16" cy="16" r="2.6" fill="currentColor" />
      </svg>
      <span>见微</span>
    </a>
    <nav class="nav">
      {SECTIONS.map((s) => (
        <a href={`/${s.id}`} class={current === s.id ? 'active' : ''}>{s.title}</a>
      ))}
    </nav>
    <ThemeSettings />
  </div>
</header>
