---
import { SECTIONS } from '../lib/sections';
import ThemeSettings from './ThemeSettings.astro';
import BrandMark from './BrandMark.astro';
const path = Astro.url.pathname.replace(/\/+$/, '');
const current = SECTIONS.find((s) => path === `/${s.id}` || path.startsWith(`/${s.id}/`))?.id;
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">
      <BrandMark size={28} />
      <span>見微</span>
    </a>
    <nav class="nav">
      {SECTIONS.map((s) => (
        <a href={`/${s.id}`} class={current === s.id ? 'active' : ''}>{s.title}</a>
      ))}
    </nav>
    <ThemeSettings />
  </div>
</header>
