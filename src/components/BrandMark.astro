---
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: cls = 'brand-mark' } = Astro.props;
const id = `bm-${size}`;
---
<svg class={cls} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  <defs><path id={id} d="M32,32 C28,32 24,24 32,12 C40,24 36,32 32,32 Z" /></defs>
  <g fill="currentColor">
    <use href={`#${id}`} />
    <use href={`#${id}`} transform="rotate(45 32 32) translate(32 32) scale(.9375) translate(-32 -32)" />
    <use href={`#${id}`} transform="rotate(90 32 32) translate(32 32) scale(.875) translate(-32 -32)" />
    <use href={`#${id}`} transform="rotate(135 32 32) translate(32 32) scale(.8125) translate(-32 -32)" />
    <use href={`#${id}`} transform="rotate(180 32 32) translate(32 32) scale(.75) translate(-32 -32)" />
    <use href={`#${id}`} transform="rotate(225 32 32) translate(32 32) scale(.8125) translate(-32 -32)" />
    <use href={`#${id}`} transform="rotate(270 32 32) translate(32 32) scale(.875) translate(-32 -32)" />
    <use href={`#${id}`} transform="rotate(315 32 32) translate(32 32) scale(.9375) translate(-32 -32)" />
  </g>
  <circle cx="32" cy="32" r="4.8" fill="var(--accent)" />
</svg>
